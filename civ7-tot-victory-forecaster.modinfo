<?xml version="1.0" encoding="utf-8"?>

<Mod id="civ7-tot-victory-forecaster-local" version="1" xmlns="ModInfo">
  <Properties>
    <Name>LOC_MOD_TOT_VF_NAME</Name>
    <Description>LOC_MOD_TOT_VF_DESCRIPTION</Description>
    <Authors>josephcasey</Authors>
    <ShowInBrowser>1</ShowInBrowser>
    <Package>CommunityMod</Package>
    <PackageSortIndex>1000</PackageSortIndex>
  </Properties>

  <Dependencies>
    <Mod id="base-standard" title="Standard Rules" />
  </Dependencies>

  <References></References>

  <ActionCriteria>
    <Criteria id="always">
      <AlwaysMet />
    </Criteria>
  </ActionCriteria>

  <ActionGroups>
    <!-- Shell scope: mod browser name/description -->
    <ActionGroup id="vf-local-shell" scope="shell" criteria="always">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Actions>
        <UpdateText>
          <Item>text/en_us/ModInfoText.xml</Item>
        </UpdateText>
      </Actions>
    </ActionGroup>

    <!-- Game scope: additive UI script that augments the victories screen.
         UIScripts (not ImportFiles) is required: we are ADDING a new script,
         not overriding an existing base-game file. -->
    <ActionGroup id="vf-local-game" scope="game" criteria="always">
      <Properties>
        <LoadOrder>1000</LoadOrder>
      </Properties>
      <Actions>
        <UpdateText>
          <Item>text/en_us/ModInfoText.xml</Item>
          <Item>text/en_us/InGameText.xml</Item>
        </UpdateText>
        <UIScripts>
          <Item>ui/victory-forecaster/victory-forecaster.js</Item>
        </UIScripts>
      </Actions>
    </ActionGroup>
  </ActionGroups>

  <LocalizedText>
    <Text>
      <Item>text/en_us/ModInfoText.xml</Item>
    </Text>
  </LocalizedText>
</Mod>
